#!/bin/bash

mysqldump -u "{{ backup_db_user }}" -p"{{ backup_user_password }}" -h localhost --single-transaction "{{ wiki_db_name }}" | gzip > "/var/backups/nexcore/{{ wiki_db_name }}_$(date +%Y%m%d).sql.gz"

mysqldump -u "{{ backup_db_user }}" -p"{{ backup_user_password }}" -h localhost --single-transaction "{{ wp_db_name }}" | gzip > "/var/backups/nexcore/{{ wp_db_name }}_$(date +%Y%m%d).sql.gz"
